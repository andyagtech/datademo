# Data files (too large for git — download per README instructions)
# Track folder structure (.gitkeep and README) but ignore actual data
data/original_downloads/*.zip
data/old_system/*
!data/old_system/.gitkeep
data/new_system/*
!data/new_system/.gitkeep

data/database/*
!data/database/.gitkeep

# Pipeline outputs (regenerated by running the pipeline)
reports/exports/
reports/report_data.json

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.hypothesis/
*.egg-info/
.venv/
venv/

# Node / JS
node_modules/
dist/

# Backend (OpenAI voice session Lambda — local only, not part of assessment)
backend/

# Bundle archives (generated by scripts/bundle.sh)
cmsdata-assessment_*.zip

# Additional data directories
data/new_claims_system_outputs/

# OS
.DS_Store
Thumbs.db

# Unused scaffolds
viewer/

# SAM build output
infra/.aws-sam/
infra/trust-policy.json

# Deploy scripts (local only)
.deploy/

# Playwright screenshot automation (not in version control)
.playwright/

# IDE
.vscode/
.idea/
*.swp
*.tmp
